# Frontend env. Copy to `.env` and adjust.
# Only variables prefixed with `VITE_` are exposed to the browser.
#
# In dev, the app talks to the Vite dev server (9000) and proxies /api → API.
# Do NOT set VITE_API_BASE_URL to localhost:8000 unless you also set
# VITE_API_BYPASS_PROXY=1 (direct calls often hit net::ERR_CONNECTION_RESET).
#
# VITE_API_BASE_URL=https://api.example.com   # production build, or
# VITE_API_BYPASS_PROXY=1
# VITE_API_BASE_URL=http://127.0.0.1:8000
