# Copy to .env and fill in. Never commit real secrets.

# --- app ---
APP_NAME=ai-agent-service
ENVIRONMENT=local                 # local | dev | staging | prod
# When local: if boto3 finds no AWS credentials and no custom DynamoDB/AWS endpoint,
# auto-switch to PERSIST_BACKEND=memory, SECRETS_BACKEND=inline, GITLAB_TOKEN_STORAGE=local.
LOCAL_AWS_AUTOFALLBACK=true
DEBUG=false
HOST=0.0.0.0
PORT=8000
# Comma-separated origins; * or an empty value allows all. JSON arrays are also accepted.
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# --- logging ---
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                   # json | console

# --- agent filesystem (app.storage_manager) ---
# Top-level path for repos/, artifacts/, cache/, tmp/ (use a writable path on your laptop).
BASE_STORAGE_PATH=./.local-ai-agent
# Legacy alias (read only if BASE_STORAGE_PATH is not set):
# AGENT_SYSTEM_ROOT=

# --- aws (shared) ---
AWS_REGION=ap-south-1
# Optional: LocalStack / custom endpoint (must be http(s) URL, not a # comment line).
AWS_ENDPOINT_URL=
# Optional: Bedrock API key (Console → Amazon Bedrock → API keys). Botocore reads
# this env name for bedrock-runtime (embeddings, summarization). Do not commit real values.
# https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys-use.html
# AWS_BEARER_TOKEN_BEDROCK=

# --- bedrock ---
# Use a geography inference profile in regions where the bare model id is blocked
# (e.g. ap-south-1: apac.…, us-east-1: us.…). Override if your account lists a different id.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=1.0
BEDROCK_TIMEOUT_SECONDS=60
BEDROCK_MAX_RETRIES=5
# Optional override; leave the next line empty to use AWS_REGION.
BEDROCK_REGION=

# --- dynamodb ---
# For dynamodb-local, set e.g. DYNAMODB_ENDPOINT_URL=http://localhost:8001 (or leave empty for AWS).
#
# Fully local laptop (no DynamoDB tables):
#   ENVIRONMENT=local
#   PERSIST_BACKEND=memory
# Keeps jobs/orgs/repos in RAM only — data is lost on process exit.
#
# GitLab PATs without AWS Secrets Manager (files under WORKSPACE_ROOT):
#   GITLAB_TOKEN_STORAGE=local
# Generic secrets API without Secrets Manager:
#   SECRETS_BACKEND=inline
#   LOCAL_SECRETS_FILE=.local-secrets.json   # optional; persists across restarts
DYNAMODB_ENDPOINT_URL=
DYNAMODB_JOBS_TABLE=jobs
DYNAMODB_ORGS_TABLE=orgs
DYNAMODB_REPOS_TABLE=repos
DYNAMODB_WORKFLOWS_TABLE=ai-agent-workflows
DYNAMODB_IDEMPOTENCY_TABLE=ai-agent-idempotency
DYNAMODB_EVENTS_OUTBOX_TABLE=ai-agent-events-outbox
DYNAMODB_HUMAN_GATES_TABLE=ai-agent-human-gates
DYNAMODB_REPOS_ORG_ID_INDEX=org_id-index
DYNAMODB_REPLY_TOKEN_INDEX=reply_token-index

# --- secrets manager ---
# Prefix for every per-org GitLab secret. Build full name with
# settings.secrets_manager.secret_name_for(org_id) — e.g.
# "orgs/org_abc/gitlab-token". Environment suffixes are handy for
# IAM scoping: "orgs/dev/" vs "orgs/prod/".
SECRETS_PREFIX=orgs/
SECRETS_CACHE_TTL_SECONDS=300

# --- email ---
EMAIL_PROVIDER=console            # ses | smtp | console
EMAIL_FROM_ADDRESS=agent@acme.dev
EMAIL_REPLY_TO_DOMAIN=mail.acme.dev
EMAIL_SES_CONFIGURATION_SET=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=10
EMAIL_DEFAULT_SUBJECT_PREFIX=[ai-agent]
EMAIL_SEND_TIMEOUT_SECONDS=10

# --- summarization worker (app.summary_worker) ---
# Master toggle for the LLM-based per-chunk summarisation pass that runs
# after ingestion. When false, process_unsummarized_chunks() is a no-op.
SUMMARIZATION_ENABLED=true
# Chunks attempted between telemetry log lines (recommended 10–20).
SUMMARIZATION_BATCH_SIZE=10
# Hard upper bound on chunks attempted per invocation.
SUMMARIZATION_MAX_CHUNKS_PER_RUN=100

# --- rag / opensearch ---
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=code-chunks

# --- eventbridge / workers ---
EVENT_BUS_NAME=spec2pr-bus

# --- relational db (optional) ---
# Example: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=

# --- integrations (app-wide, not per-org) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_SECRET_ARN=
APP_SECRET_NAME=                  # JSON secret with github_token/repo_url/user_email

# --- WORKSPACE_ROOT (not clone path) ---
# Clones/artifacts: use BASE_STORAGE_PATH above, e.g. <BASE>/repos/<org_id>/<repo_id>/
# This path is only for local dev GitLab token files when GITLAB_TOKEN_STORAGE=local.
WORKSPACE_ROOT=./.local-workspace
# If AWS Secrets Manager is not available (e.g. missing IAM for CreateSecret) and
# ENVIRONMENT=local, set: GITLAB_TOKEN_STORAGE=local
# (tokens are written as JSON under WORKSPACE_ROOT/.local-gitlab-tokens — dev only)
GITLAB_TOKEN_STORAGE=secrets_manager
